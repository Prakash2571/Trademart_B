# Trademart site configuration for ${DOMAIN}.
#
# This file is a TEMPLATE. The official nginx entrypoint renders it to
# /etc/nginx/conf.d/default.conf at container start. Only the DOMAIN variable is
# expanded: NGINX_ENVSUBST_FILTER="^DOMAIN$" in docker-compose.yml keeps envsubst
# away from nginx's own runtime variables such as $host and $request_uri, which
# it would otherwise replace with empty strings.
#
# Edit this file, never conf.d/default.conf. Then: docker compose restart nginx
#
# IPv4-only `listen` directives on purpose. Docker bridge networks have IPv6
# disabled unless you set enable_ipv6 on the network, and binding `[::]:80` in a
# container without IPv6 is fatal, not a warning:
#
#   [emerg] socket() [::]:80 failed (97: Address family not supported by protocol)
#
# nginx then exits 1 and the container crash-loops. (This is exactly why the
# official image ships 10-listen-on-ipv6-by-default.sh, which probes
# /proc/net/if_inet6 before adding any IPv6 listener.) If you do enable IPv6 on
# the compose network, add the matching `listen [::]:...` lines back here.
#
# Routing:
#   /api/*         -> backend:4000   (Express mounts EVERYTHING under /api,
#                                     so the prefix is passed through as-is)
#   /_next/static/ -> frontend:3000  (immutable, content-hashed assets)
#   /*             -> frontend:3000  (Next.js server: pages, RSC, /_next/image)

# ---------------------------------------------------------------------------
# Container-internal health endpoint. Port 8080 is never published, so this is
# only reachable from inside the container and the compose network. Used by the
# nginx HEALTHCHECK.
# ---------------------------------------------------------------------------
server {
    listen 8080;
    server_name _;
    access_log off;

    location = /healthz {
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}

# ---------------------------------------------------------------------------
# Catch-all. Anything arriving with an unexpected Host header (IP scans, other
# domains pointed at this box) is dropped rather than served the app.
# ssl_reject_handshake means this block needs no certificate of its own.
# ---------------------------------------------------------------------------
server {
    listen 80 default_server;
    listen 443 ssl default_server;

    ssl_reject_handshake on;

    server_name _;
    access_log off;
    return 444;
}

# ---------------------------------------------------------------------------
# HTTP: serve the ACME challenge, redirect everything else to HTTPS.
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    # Let's Encrypt http-01. MUST stay on plain HTTP and must not be redirected.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        access_log off;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# ---------------------------------------------------------------------------
# HTTPS: www -> apex, so there is exactly one canonical origin. That matters
# here because the backend's CORS allowlist holds a single FRONTEND_URL.
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;

    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    return 301 https://${DOMAIN}$request_uri;
}

# ---------------------------------------------------------------------------
# HTTPS: the application.
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;

    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/security-headers.conf;

    access_log /var/log/nginx/trademart.access.log main;
    error_log  /var/log/nginx/trademart.error.log warn;

    # ---- Backend API ------------------------------------------------------
    # Covers /api/health, /api/shopify/*, /api/pricing/*, /api/analytics/*,
    # /api/suppliers/* and /api/webhooks/shopify.
    location /api/ {
        # A variable in proxy_pass forces DNS re-resolution per request (see the
        # `resolver` directive in nginx.conf), so recreating the backend
        # container does not strand nginx on a dead IP. With no URI component
        # after the host, the original request URI - including /api - is passed
        # through unchanged.
        set $trademart_backend backend:4000;

        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Connection "";

        # Shopify Admin GraphQL calls can be slow, and the throttle layer
        # retries on cost limits.
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        # Webhook HMAC is computed over the exact request bytes. Buffering the
        # body is fine (nginx forwards it verbatim); what would break it is any
        # body-rewriting module. Do not add one to this location.
        proxy_pass http://$trademart_backend;
    }

    # ---- Next.js build assets --------------------------------------------
    # Content-hashed filenames, so they can be cached by the browser forever.
    location /_next/static/ {
        set $trademart_frontend frontend:3000;

        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Connection "";

        proxy_pass http://$trademart_frontend;

        # This block declares add_header, so the server-level security headers
        # are no longer inherited and have to be re-included.
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # ---- Everything else: the Next.js server ------------------------------
    location / {
        set $trademart_frontend frontend:3000;

        include /etc/nginx/snippets/proxy.conf;

        # Next streams RSC payloads and (in dev) uses a websocket for HMR.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_pass http://$trademart_frontend;
    }
}

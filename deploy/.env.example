#######################################################################
# Trademart deployment environment
#
#   cp .env.example .env    &&    $EDITOR .env    &&    ./start.sh
#
# This one file feeds BOTH:
#   1. docker-compose.yml interpolation  (${DOMAIN}, image tags, build args)
#   2. the backend container's process env
#
# NEVER commit .env - it is gitignored. Nothing here is baked into an image
# except NEXT_PUBLIC_API_BASE_URL, which is public by design.
#
# Compose .env quirks, worth knowing before you paste a secret:
#   - `$` is interpolated. Write `$$` for a literal dollar sign, or just avoid
#     `$` in generated passwords.
#   - `#` only starts a comment at the beginning of a line, never inline.
#   - Do not quote values unless the quotes are part of the value.
#######################################################################


#######################################################################
# Public identity
#######################################################################

# Apex domain. www.<DOMAIN> is issued a certificate too and 301s to the apex.
# Both must already have A/AAAA records pointing at this host before ./start.sh
# can complete the Let's Encrypt http-01 challenge.
DOMAIN=trademart.online

# Where Let's Encrypt sends expiry warnings. Required for TLS_MODE=letsencrypt.
LETSENCRYPT_EMAIL=ops@trademart.online

# letsencrypt = real, trusted certificate (needs public DNS + ports 80/443 open)
# selfsigned  = throwaway certificate, for testing the stack before DNS is ready
TLS_MODE=letsencrypt

# Set to 1 to hit Let's Encrypt's staging CA while you are still debugging.
# Staging has generous rate limits; production allows only 5 failures per
# hostname per hour. Certificates issued in staging are NOT browser-trusted.
# Switch to 0 and run `./start.sh --force-renew` for the real thing.
LETSENCRYPT_STAGING=0


#######################################################################
# Backend (Trademart_B)
#
# Full reference for every variable: ../.env.example
# NODE_ENV is pinned to production by docker-compose.yml, which makes
# MONGODB_URI and Shopify credentials HARD requirements - the process exits 1
# without them rather than booting degraded.
#######################################################################

# The single origin allowed through the API's CORS allowlist. Must be the exact
# public origin, no trailing slash, no www (nginx redirects www to the apex).
FRONTEND_URL=https://trademart.online

# --- Shopify ---------------------------------------------------------------
# The .myshopify.com domain, NOT the admin.shopify.com/store/... URL.
SHOPIFY_STORE_DOMAIN=teststoremart-uk8mmby.myshopify.com
SHOPIFY_API_VERSION=2026-07

# Client credentials grant. The backend exchanges these for a short-lived Admin
# API token and refreshes it automatically. Dev Dashboard -> app -> Settings.
# The app must be INSTALLED on the store above.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional override. If set, this token is used verbatim INSTEAD of the client
# credentials grant, with no automatic refresh. Leave blank normally.
SHOPIFY_ACCESS_TOKEN=

# Verifies the X-Shopify-Hmac-Sha256 header. Without it every delivery to
# POST /api/webhooks/shopify is rejected.
SHOPIFY_WEBHOOK_SECRET=


#######################################################################
# Frontend (Trademart_F)
#######################################################################

# Baked into the browser bundle at BUILD time, so it must be resolvable by the
# visitor's browser - never a compose service name like http://backend:4000.
#
# `/api` (relative, same-origin through nginx) is the right answer here: it
# works on any domain and skips CORS preflights entirely. Only use an absolute
# URL if the API is served from a different origin.
NEXT_PUBLIC_API_BASE_URL=/api

# Path to the frontend repo, relative to this deploy/ directory. The default
# assumes Trademart_B and Trademart_F are cloned side by side.
FRONTEND_CONTEXT=../../Trademart_F


#######################################################################
# MongoDB - EXTERNAL by default (e.g. MongoDB Atlas)
#
# The base stack ships NO database container, so nothing pulls a Mongo image.
# Just point MONGODB_URI at your external server. Required when
# NODE_ENV=production (which compose pins): the API exits 1 without it.
#
# URL-encode any reserved characters (@ : / ? # [ ] %) in the password.
#######################################################################

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trademart?retryWrites=true&w=majority

# --- OR: run Mongo inside the stack instead of Atlas -----------------------
# Uncomment the line below and the three settings under it, then fill in a
# password. This activates docker-compose.local-db.yml, which adds the mongo
# container (data in the trademart_mongo_data volume, never published to the
# host) and makes the backend wait for it to be healthy.
#
#   COMPOSE_FILE=docker-compose.yml:docker-compose.local-db.yml
#   MONGO_INITDB_ROOT_USERNAME=trademart
#   MONGO_INITDB_ROOT_PASSWORD=<openssl rand -hex 24>
#   MONGODB_URI=mongodb://trademart:<same password>@mongo:27017/trademart?authSource=admin
#
# WiredTiger cache ceiling in GB (local Mongo only). Keep it under the host RAM.
#   MONGO_CACHE_SIZE_GB=1


#######################################################################
# Host bindings (rarely changed)
#######################################################################

# Change these only if something else on the host already owns 80/443. Note
# that Let's Encrypt's http-01 challenge always arrives on port 80, so HTTP_PORT
# must be 80 for TLS_MODE=letsencrypt unless another proxy forwards to it.
HTTP_PORT=80
HTTPS_PORT=443

# Tag applied to the locally built images.
IMAGE_TAG=latest

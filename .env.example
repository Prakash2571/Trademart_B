#######################################################################
# Trademart backend - example environment
#
# Copy to .env and fill in the blanks:   cp .env.example .env
# NEVER commit .env. NEVER put any of these values in the frontend.
#######################################################################

NODE_ENV=development
PORT=4000

# Origin allowed by CORS. Next.js dev server defaults to port 3000.
FRONTEND_URL=http://localhost:3000

#######################################################################
# APP_URL - this backend's own PUBLIC origin
#
# Different from FRONTEND_URL: that is the browser app, this is the API as
# SHOPIFY sees it. Needed for two things, and optional if you use neither:
#
#   1. the OAuth redirect flow  -> APP_URL/api/auth/callback
#   2. webhook registration     -> APP_URL/api/webhooks/shopify
#
# Shopify cannot reach localhost. For local testing use a public tunnel
# (e.g. `shopify app dev` or `cloudflared tunnel --url http://localhost:4000`)
# and paste that https URL here. Must be https when NODE_ENV=production.
#
# Leave blank to disable OAuth and webhook registration entirely; the
# dashboard still works via the client credentials grant.
#######################################################################
APP_URL=

#######################################################################
# Database (MongoDB for this test version)
#
# Local:  mongodb://127.0.0.1:27017/trademart
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trademart?retryWrites=true&w=majority
#
# Leave blank to run the API without a database. Shopify read endpoints
# and the pricing engine work without Mongo; only persistence is disabled.
#######################################################################
MONGODB_URI=

#######################################################################
# Shopify
#
# Use the .myshopify.com domain - NOT admin.shopify.com/store/...
#######################################################################
SHOPIFY_STORE_DOMAIN=teststoremart-uk8mmby.myshopify.com
SHOPIFY_API_VERSION=2026-07

#######################################################################
# Shopify authentication - CLIENT CREDENTIALS GRANT
#
# These are the only two credentials you need. The backend exchanges them
# for a short-lived Admin API access token automatically, caches it, and
# refreshes it shortly before it expires. There is no token to copy by hand
# and nothing to rotate manually.
#
# Where to find them:
#   Shopify Dev Dashboard -> your "Trademart" app -> Settings
#     Client ID
#     Client secret
#
# The app must be INSTALLED on the store named above, otherwise Shopify
# replies "Client credentials cannot be performed on this shop".
#
# Backend-only. Never expose either value to the browser.
# https://shopify.dev/docs/apps/build/authentication-authorization/access-tokens/client-credentials-grant
#######################################################################
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

#######################################################################
# OPTIONAL override - leave blank unless you specifically need it.
#
# Setting this makes the backend use the supplied token verbatim INSTEAD of
# the client credentials grant, which means no automatic refresh. Only useful
# for an admin-created custom app that issued a long-lived shpat_ token, or
# for debugging against a known token.
#######################################################################
SHOPIFY_ACCESS_TOKEN=

#######################################################################
# Webhooks
#
# Used to verify the X-Shopify-Hmac-Sha256 header on every delivery. The
# receiver REJECTS all traffic without it, and registration refuses to run
# (registering subscriptions whose deliveries you then reject is worse than
# not registering at all).
#
# Find it in the Shopify Dev Dashboard under your app's webhook settings.
# This is NOT the client secret.
#
# Once set, register the subscriptions:
#   curl -X POST "http://localhost:4000/api/webhooks/register?dryRun=1"   # preview
#   curl -X POST  http://localhost:4000/api/webhooks/register             # apply
#######################################################################
SHOPIFY_WEBHOOK_SECRET=

#######################################################################
# OAuth redirect flow (OPTIONAL)
#
# Only needed if you install the app via the redirect flow instead of
# Shopify-managed installation. See docs/OAUTH_AND_WEBHOOKS.md.
#
# SHOPIFY_SCOPES  - scopes requested by the authorize URL. Blank uses the list
#                   DERIVED from src/shopify/capabilities.ts, which is the
#                   single source of truth for scope requirements:
#                     read_customers, read_inventory, read_locations,
#                     read_orders, read_products, read_themes,
#                     write_inventory, write_products
#                   write_themes is deliberately excluded - theme editing is
#                   not implemented, and Shopify additionally gates theme
#                   writes behind a per-app exemption.
#                   Inspect what your store granted, and why a feature is
#                   unavailable, with GET /api/shopify/capabilities.
#                   Under managed installation the scopes come from
#                   shopify.app.toml instead and this is ignored.
#
# SHOPIFY_AUTH_MODE - which token the Admin API calls use:
#                   auto  (default) client credentials grant, unchanged
#                   oauth           the stored per-merchant offline token
#                   Switching to oauth requires APP_URL and
#                   TOKEN_ENCRYPTION_KEY, and a completed install.
#
# TOKEN_ENCRYPTION_KEY - AES-256-GCM key encrypting offline tokens at rest.
#                   Offline tokens are NEVER stored in plaintext. 32 bytes,
#                   hex or base64. Generate one with:
#                       openssl rand -base64 32
#                   Changing it invalidates every stored token (merchants
#                   must reinstall), so treat it as a long-lived secret.
#######################################################################
SHOPIFY_SCOPES=

# SHOPIFY_STORE_MODE - development | production (optional, advisory). Marks the
#                   store type for dev/test TOOLING safety. Never trusted alone:
#                   Shopify's real isDevelopmentStore overrides it when known.
# ALLOW_LIVE_STORE_WRITES - default false. When false, automated tooling
#                   (smoke/seed/write-test scripts) refuses to mutate a store
#                   that is not a development store. Normal operator actions are
#                   NOT affected. Set true only to deliberately test writes
#                   against a live store.
SHOPIFY_STORE_MODE=
ALLOW_LIVE_STORE_WRITES=false
SHOPIFY_AUTH_MODE=auto
TOKEN_ENCRYPTION_KEY=

#######################################################################
# Storefront automation - MASTER KILL SWITCH
#
# When true, Trademart is allowed to CHANGE YOUR LIVE STORE: product
# prices and whether products are visible. Defaults to false.
#
# Must be exactly "true" or "false". A typo is a startup error rather
# than being silently treated as one or the other.
#
# Preview always works regardless of this setting:
#   curl -X POST http://localhost:4000/api/automation/preview   # reports only
#   curl -X POST http://localhost:4000/api/automation/apply     # needs true
#
# Requires the write_products scope. Prices are derived from Shopify's
# "Cost per item" (inventoryItem.unitCost), which needs read_inventory -
# any dropshipping app (Tradelle, DSers, Zendrop, CJ, AutoDS) populates it.
#
# Run preview against your real catalogue and read the output BEFORE
# setting this to true. See docs/AUTOMATION.md.
#######################################################################
AUTOMATION_ENABLED=false

#######################################################################
# Hands-off syncing - let Shopify webhooks trigger automation
#
# When true, a product or stock change in Shopify automatically triggers
# an automation run for that product. This is what removes the manual
# step: a dropshipping app updates a cost, and your price follows.
#
# Requires AUTOMATION_ENABLED=true (a trigger that cannot write is just
# wasted API calls) and SHOPIFY_WEBHOOK_SECRET, plus registered
# subscriptions:  curl -X POST .../api/webhooks/register
#
# Deliberately a SECOND switch: "Trademart may write" and "Trademart
# writes without me asking" are different levels of trust.
#
# Automatic runs use your SAVED rules (PUT /api/automation/rules), not
# the request body - a webhook has no body to read.
#######################################################################
AUTOMATION_ON_WEBHOOK=false


#######################################################################
# Operator authentication - PROTECTS EVERY WRITE ENDPOINT
#
# CORS is not authentication. Without these, /api/automation/apply and the
# other management endpoints are callable by anyone who knows the URL. The
# middleware FAILS CLOSED: with nothing configured, every mutation is refused.
#
# Two ways to authenticate:
#   1. Browser console -> password login -> HttpOnly session cookie (+ CSRF).
#      Needs OPERATOR_PASSWORD_HASH and SESSION_SECRET.
#   2. Scripts / cron -> Authorization: Bearer <OPERATOR_API_KEY> (no CSRF).
#
# Generate the password hash (never store the plaintext):
#   npm run operator:hash
# Generate the secrets:
#   openssl rand -base64 48   # SESSION_SECRET
#   openssl rand -base64 32   # OPERATOR_API_KEY
#######################################################################

# Login username for the console. Defaults to "operator". No colon allowed.
OPERATOR_USERNAME=operator

# scrypt hash of the password, from `npm run operator:hash`. NEVER the plaintext.
OPERATOR_PASSWORD_HASH=

# HMAC key that signs session cookies. >= 32 chars. Rotating it logs everyone out.
SESSION_SECRET=

# Optional pre-shared key for non-browser clients. >= 24 chars. Exempt from CSRF.
OPERATOR_API_KEY=

# Session lifetime in hours (1-720). Default 12.
SESSION_TTL_HOURS=12

# When true, READ endpoints also require a signed-in operator. Default false, so
# enabling auth cannot black out a dashboard whose login screen is not deployed
# yet. Mutations are ALWAYS protected regardless of this.
OPERATOR_PROTECT_READS=false
